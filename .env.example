# Server-side DeepSeek connection. Copy to .env.local, then insert your key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Persistent local SQLite file. Docker uses a named volume.
DATABASE_PATH=.data/ostrovok.sqlite
# Set true behind HTTPS. Phone login is DEMO ONLY: any valid phone + 0000.
COOKIE_SECURE=false

# Vercel only: linked PRIVATE Blob store. Never expose this token to the browser.
# Snapshots persist across function restarts; local SQLite remains the default.
BLOB_READ_WRITE_TOKEN=
# Optional namespace override. Defaults: production/ostrovok.sqlite or preview/ostrovok.sqlite.
OSTROVOK_BLOB_DATABASE_PATH=
