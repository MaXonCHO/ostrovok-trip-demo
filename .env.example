# Server-side DeepSeek connection. Copy to .env.local, then insert your key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Persistent local SQLite file. Docker uses a named volume.
DATABASE_PATH=.data/ostrovok.sqlite
# Set true behind HTTPS. Phone login is DEMO ONLY: any valid phone + 0000.
COOKIE_SECURE=false

# Explicit ranking mode. E5 failure returns 503; it never switches modes silently.
HOTEL_SEARCH_ENGINE=tfidf
# Server-only FastAPI URL. No NEXT_PUBLIC_ prefix and no browser-to-model calls.
E5_BASE_URL=http://127.0.0.1:8000
