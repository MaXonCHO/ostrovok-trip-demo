CATALOG_PROVIDER=fixture
TRIP_STORE=json
# mock works offline; deepseek uses the real API.
AGENT_PROVIDER=mock
# Server-only secret, never use NEXT_PUBLIC_ or commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
RECOMMENDATION_PROVIDER=fixture
GEO_PROVIDER=fixture
# Leave empty locally: the invite uses the address in your browser.
APP_BASE_URL=
# false for local HTTP; set true behind public HTTPS.
COOKIE_SECURE=false
# Docker Compose overrides this to /app/data.
TRIP_DATA_DIR=.data
